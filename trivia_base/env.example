# Firebase Configuration for Trivia Base
# Copy this file to .env.local and fill in your actual values
VITE_TRIVIA_BASE_FIREBASE_API_KEY=your_api_key_here
VITE_TRIVIA_BASE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_TRIVIA_BASE_FIREBASE_PROJECT_ID=your_project_id
VITE_TRIVIA_BASE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_TRIVIA_BASE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_TRIVIA_BASE_FIREBASE_APP_ID=your_app_id
